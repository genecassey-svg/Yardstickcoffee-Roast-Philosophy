*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
}

body{
font-family:Inter,sans-serif;
background:#0f172a;
color:white;
transition:.3s;
}

body.light{
background:#fafafa;
color:#222;
}

nav{
display:flex;
justify-content:space-between;
align-items:center;
padding:20px 10%;
position:sticky;
top:0;
background:rgba(15,23,42,.9);
backdrop-filter:blur(10px);
}

body.light nav{
background:white;
}

nav ul{
display:flex;
list-style:none;
gap:30px;
}

nav a{
color:inherit;
text-decoration:none;
}

.logo{
font-size:24px;
font-weight:700;
}

header{
height:90vh;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
padding:20px;
}

header h1{
font-size:60px;
margin-bottom:10px;
}

header h2{
font-size:40px;
margin-bottom:15px;
}

header p{
max-width:600px;
line-height:1.8;
margin-bottom:30px;
}

.button{
padding:15px 35px;
background:#3b82f6;
color:white;
text-decoration:none;
border-radius:8px;
}

section{
padding:80px 10%;
}

section h2{
margin-bottom:30px;
font-size:32px;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
gap:25px;
}

.card{
padding:25px;
border-radius:12px;
background:#1e293b;
transition:.3s;
}

body.light .card{
background:white;
box-shadow:0 5px 15px rgba(0,0,0,.1);
}

.card:hover{
transform:translateY(-6px);
}

.card a{
display:inline-block;
margin-top:15px;
color:#60a5fa;
}

.chips{
display:flex;
flex-wrap:wrap;
gap:12px;
}

.chips span{
padding:10px 18px;
background:#2563eb;
border-radius:20px;
}

footer{
text-align:center;
padding:40px;
}

#themeToggle{
cursor:pointer;
font-size:20px;
background:none;
border:none;
color:inherit;
}

@media(max-width:700px){

nav{
flex-direction:column;
gap:15px;
}

header h1{
font-size:42px;
}

header h2{
font-size:30px;
}

}
const btn=document.getElementById("themeToggle");

btn.onclick=()=>{

document.body.classList.toggle("light");

btn.textContent=
document.body.classList.contains("light")
?"☀️":"🌙";

};
# My Portfolio

This is my personal portfolio hosted with GitHub Pages.

## Deployment

1. Create a repository named:

```
yourusername.github.io
```

2. Upload:

- index.html
- style.css
- script.js

3. Go to:

Settings → Pages

Deploy from:

main branch

/root

Your website will be available at:

```
https://yourusername.github.io
```
